*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
:root{--pink:#C9376E;--pink-light:#FDF2F6;--pink-soft:#FCE7EF;--dark:#1A1A1A;--grey:#6B6B6B;--light-grey:#F7F7F7;--border:#EDEDED;--gold:#B9975B}
