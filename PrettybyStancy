.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;z-index:150}.overlay.show{display:block}
.checkout{max-width:820px;margin:0 auto;background:#fff;padding:32px;border:1px solid var(--border);border-radius:16px}
.checkout h3{font-family:'Playfair Display',serif;font-size:20px;margin:22px 0 12px}
input,select,textarea{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:10px;margin-bottom:12px;background:#FAFAFA;font-size:14px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--pink);background:#fff}
