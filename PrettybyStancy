.contact{background:#1A1A1A;color:#fff;border-radius:18px;margin:0 5% 40px;padding:44px;display:grid;grid-template-columns:1fr 1fr;gap:36px}.contact input,.contact textarea{background:#fff;color:#000}.contact h2{font-family:'Playfair Display',serif;font-size:32px}.contact a{color:#F8C8D8;text-decoration:underline}
footer{text-align:center;padding:24px;color:#888;font-size:13px;border-top:1px solid var(--border)}
