let cart=[];let selections={};let currentFilter='all';let searchTerm='';
function stockLabel(p){if(p.stock===0)return `<div class="stock out">Out of Stock</div>`;if(p.stock<=3)return `<div class="stock low">Only ${p.stock} left in stock</div>`;return `<div class="stock in">In Stock — ${p.stock} available</div>`}
function searchProducts(v){searchTerm=v.toLowerCase();renderProducts()}
function renderProducts(){
  const grid=document.getElementById('productGrid');grid.innerHTML='';
  const list=products.filter(p=>(currentFilter==='all'||p.cat===currentFilter)&&(searchTerm===''||p.name.toLowerCase().includes(searchTerm)));
  if(list.length===0){grid.innerHTML='<p style="grid-column:1/-1;text-align:center;color:#888">No products found.</p>';return}
  list.forEach(p=>{
    selections[p.id]={size:p.sizes[0],color:p.colors[0]};
    const isOut=p.stock===0;
    const discount=Math.round((1-p.price/p.old)*100);
    grid.innerHTML+=`<div class="card ${isOut?'out':''}">${isOut?'<div class="badge-out">OUT OF STOCK</div>':''}${!isOut&&p.stock<=3?'<div class="badge-low">LOW STOCK</div>':''}<div class="card-img-wrap"><img src="${p.img}" alt="${p.name}"></div><div class="card-body"><span class="badge">${p.badge}</span><h3>${p.name}</h3><div class="stars">${p.rating}</div><div class="price">GH¢ ${p.price} <s>GH¢ ${p.old}</s><span>-${discount}%</span></div>${stockLabel(p)}<span class="opt-label">Select Size</span><div class="sizes">${p.sizes.map((s,i)=>`<button class="${i==0?'selected':''}" onclick="pickSize(${p.id},'${s}',this)">${s}</button>`).join('')}</div><span class="opt-label">Select Colour</span><div class="colors">${p.colors.map((c,i)=>`<div class="color ${i==0?'selected':''}" style="background:${c}" onclick="pickColor(${p.id},'${c}',this)"></div>`).join('')}</div><button class="add-btn" ${isOut?'disabled':''} onclick="addToCart(${p.id})">${isOut?'Out of Stock':'Add to Cart'}</button>${isOut?`<button class="notify-btn" onclick="notifyMe('${p.name}')">Notify Me When Available</button>`:''}</div></div>`;
  });
}
function pickSize(id,size,el){selections[id].size=size;el.parentElement.querySelectorAll('button').forEach(b=>b.classList.remove('selected'));el.classList.add('selected')}
function pickColor(id,color,el){selections[id].color=color;el.parentElement.querySelectorAll('.color').forEach(c=>c.classList.remove('selected'));el.classList.add('selected')}
function filterCat(cat,btn){currentFilter=cat;if(btn){document.querySelectorAll('.filters button').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}renderProducts();document.getElementById('shop').scrollIntoView({behavior:'smooth'})}
function addToCart(id){
  const p=products.find(x=>x.id===id);if(p.stock===0)return;
  const sel=selections[id];const key=id+'-'+sel.size+'-'+sel.color;
  const found=cart.find(i=>i.key===key);if(found){if(found.qty>=p.stock){showToast('Sorry, only '+p.stock+' left in stock.');return}found.qty++}else cart.push({key,...p,...sel,qty:1});
  updateCart();showToast(p.name+' added to bag');openCart();
}
function updateCart(){
  document.getElementById('cartCount').innerText=cart.reduce((a,b)=>a+b.qty,0);
  const wrap=document.getElementById('cartItems');
  if(cart.length===0){wrap.innerHTML='<p style="text-align:center;color:#888;margin:20px 0">Your bag is empty.</p>';document.getElementById('cartSummary').innerHTML='';document.getElementById('checkoutSummary').innerHTML='Your cart is empty - add a product first.';return}
  wrap.innerHTML=cart.map((i,idx)=>`<div class="cart-item"><img src="${i.img}"><div style="flex:1"><b style="font-size:14px">${i.name}</b><br><small>Size: ${i.size} • <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${i.color};vertical-align:middle"></span></small><br><b>GH¢ ${i.price*i.qty}</b><div class="qty" style="margin-top:6px"><button onclick="changeQty(${idx},-1)">-</button> ${i.qty} <button onclick="changeQty(${idx},1)">+</button> <span style="float:right;cursor:pointer" onclick="removeItem(${idx})">Remove</span></div></div></div>`).join('');
  const subtotal=cart.reduce((a,b)=>a+b.price*b.qty,0);const delivery=subtotal>=500?0:30;const total=subtotal+delivery;
  document.getElementById('cartSummary').innerHTML=`<div style="display:flex;justify-content:space-between;margin-top:10px"><span>Subtotal</span><b>GH¢ ${subtotal}</b></div><div style="display:flex;justify-content:space-between"><span>Delivery</span><b>${delivery===0?'FREE':'GH¢ '+delivery}</b></div><div style="display:flex;justify-content:space-between;font-size:18px;margin-top:8px"><span>Total</span><b>GH¢ ${total}</b></div>`;
  document.getElementById('checkoutSummary').innerHTML=cart.map(i=>`${i.name} (Size ${i.size}) x ${i.qty} - GH¢ ${i.price*i.qty}`).join('<br>')+`<br><br><b>Delivery: GH¢ ${delivery} | Total: GH¢ ${total}</b>`;
}
function changeQty(idx,d){cart[idx].qty+=d;if(cart[idx].qty<=0)cart.splice(idx,1);updateCart()}
function removeItem(idx){cart.splice(idx,1);updateCart()}
function openCart(){document.getElementById('cartDrawer').classList.add('open');document.getElementById('overlay').classList.add('show')}
function closeCart(){document.getElementById('cartDrawer').classList.remove('open');document.getElementById('overlay').classList.remove('show')}
function showPay(type){
  document.getElementById('payMomo').style.display=type==='momo'?'block':'none';
  document.getElementById('payCard').style.display=type==='card'?'block':'none';
  document.getElementById('payCash').style.display=type==='cash'?'block':'none';
  document.getElementById('tabMomo').classList.toggle('active',type==='momo');
  document.getElementById('tabCard').classList.toggle('active',type==='card');
  document.getElementById('tabCash').classList.toggle('active',type==='cash');
}
function showToast(msg){const t=document.getElementById('toast');t.innerText=msg;t.style.display='block';setTimeout(()=>t.style.display='none',2500)}
function notifyMe(name){window.open(`https://wa.me/233595270488?text=Hi Stancy, Please notify me when ${name} is back in stock.`,'_blank')}
function placeOrder(){
  const name=document.getElementById('custName').value;const phone=document.getElementById('custPhone').value;const loc=document.getElementById('custLocation').value;
  if(!name||!phone||!loc){alert('Please fill your Name, Phone and Location');return}
  if(cart.length===0){alert('Your cart is empty.');return}
  const subtotal=cart.reduce((a,b)=>a+b.price*b.qty,0);const delivery=subtotal>=500?0:30;const total=subtotal+delivery;
  const msg=`Hi Pretty by Stancy, I want to order:%0A%0A${cart.map(i=>`${i.name} - Size ${i.size} x${i.qty} = GH¢${i.price*i.qty}`).join('%0A')}%0A%0ADelivery: GH¢${delivery}%0ATotal: GH¢${total}%0AName: ${name}%0APhone: ${phone}%0ALocation: ${loc}`;
  window.open(`https://wa.me/233595270488?text=${msg}`,'_blank');
  showToast('Order sent. We will confirm on WhatsApp.');cart=[];updateCart();
}
function sendEnquiry(){const n=document.getElementById('contactName').value||'Customer';const m=document.getElementById('contactMsg').value||'Hi, I have a question';window.open(`https://wa.me/233595270488?text=Hi Stancy, I am ${n}. ${m}`,'_blank')}
renderProducts();updateCart();
</script>
</body>
</html>
