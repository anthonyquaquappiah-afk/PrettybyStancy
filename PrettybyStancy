@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-img{height:320px}.hero-text h1{font-size:38px}.collections{grid-template-columns:1fr}.contact{grid-template-columns:1fr}nav{display:none}.search-input{display:none}}
</style>
</head>
